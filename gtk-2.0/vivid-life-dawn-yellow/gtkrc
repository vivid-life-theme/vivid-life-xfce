# bg[NORMAL] is the trough; the bar itself is drawn with the selected
# colours, which is why an accent progress bar needs no separate key.
style "vivid-life-progress" {
  bg[NORMAL]   = "#bdbdbd"
  bg[PRELIGHT] = "#713f12"
  bg[SELECTED] = "#713f12"
  fg[PRELIGHT] = "#f5f5f5"
}

