{
  "name": "vivid-life-xfce",
  "version": "0.1.0",
  "private": true,
  "description": "Vivid Life Theme port for Xfce (GTK2/GTK3/GTK4 + Xfwm4) with an auto-detecting installer.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test 'tools/**/*.test.mjs'",
    "generate": "node tools/generate.mjs",
    "check": "node tools/generate.mjs --check",
    "preview": "/usr/bin/python3 tools/preview/gallery.py",
    "preview:shots": "sh tools/preview/shots.sh"
  },
  "dependencies": {
    "@vivid-life-theme/design-system": "0.8.0"
  },
  "license": "MIT"
}
